# ---------------------------------------------------------------------------
# SHIGOTAI environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development            # development | production
DEMO_MODE=true                     # true = seed and serve clearly-labeled demo jobs
AUTH_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# The deployed frontend URL. Used to build links in outgoing emails
# (verify-email, password reset, job match notifications) -- must be the
# real domain in production, not localhost.
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Local dev default (zero-config): sqlite:///./shigotai.db
# Production: postgresql+psycopg://user:password@host:5432/shigotai
# (Neon/Supabase/RDS connection strings already use this driver prefix, or
# just add "+psycopg" after "postgresql" if yours doesn't.)
DATABASE_URL=sqlite:///./shigotai.db

# --- Background queue ---
# Local dev default: none (in-process synchronous processing is used automatically)
# Production: redis://user:password@host:6379/0 (enables Celery-based workers; see README)
REDIS_URL=

# --- AI / LLM provider ---
# When unset, Shigotai uses the built-in rule-based DevLLMProvider so the
# app is fully functional with no external API key.
LLM_PROVIDER=dev                   # dev | anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Email provider ---
# When unset, emails are written to backend/var/outbox/ instead of being sent.
EMAIL_PROVIDER=dev                 # dev | resend
EMAIL_API_KEY=
EMAIL_FROM=notifications@shigotai.app

# --- File storage (resume uploads) ---
# "dev" writes to backend/var/uploads/ on local disk -- fine for local dev,
# but most hosting platforms have an ephemeral or read-only filesystem, so
# set this to "s3" before deploying anywhere that isn't your own machine.
# Works with AWS S3 or any S3-compatible store (Cloudflare R2, Backblaze B2)
# via STORAGE_ENDPOINT_URL.
STORAGE_PROVIDER=dev                # dev | s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=               # leave blank for AWS S3; set for R2/B2/MinIO
STORAGE_PUBLIC_BASE_URL=            # optional CDN/public URL prefix

# --- Web Push ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@shigotai.app

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
