# ---------------------------------------------------------------------------
# SHIGOTAI environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development            # development | production
DEMO_MODE=true                     # true = seed and serve clearly-labeled demo jobs
AUTH_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# The deployed frontend URL. Used to build links in outgoing emails
# (verify-email, password reset, job match notifications) -- must be the
# real domain in production, not localhost.
FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database ---
# Local dev default (zero-config): sqlite:///./shigotai.db
# Production: postgresql+psycopg://user:password@host:5432/shigotai
# (Neon/Supabase/RDS connection strings already use this driver prefix, or
# just add "+psycopg" after "postgresql" if yours doesn't.)
DATABASE_URL=sqlite:///./shigotai.db

# --- Background queue ---
# Local dev default: none (in-process synchronous processing is used automatically)
# Production: redis://user:password@host:6379/0 (enables Celery-based workers; see README)
REDIS_URL=

# --- AI / LLM provider ---
# Used for job-requirement extraction and match explanations. When unset,
# Shigotai uses the built-in rule-based DevLLMProvider so the app is fully
# functional with no external API key.
#   anthropic                  -> Claude (paid; LLM_MODEL defaults to claude-opus-5-5,
#                                 claude-haiku-5-5 is ~40x cheaper)
#   groq | gemini | openrouter -> free tiers; LLM_MODEL is required -- copy a
#                                 model ID from the provider's console
#   openai_compatible          -> any OpenAI-style endpoint via LLM_BASE_URL
LLM_PROVIDER=dev
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Seconds between LLM calls; ~2.5 keeps batch ingestion under a 30/min free tier.
LLM_MIN_INTERVAL_SECONDS=0
# Max LLM-written match explanations per recompute (the rest are rule-based).
MAX_LLM_EXPLANATIONS_PER_RECOMPUTE=8

# Optional separate provider for resume parsing. Resumes are personal data:
# pick a provider whose terms don't train on your inputs (Gemini's free tier
# may). Blank = reuse LLM_* above.
RESUME_LLM_PROVIDER=
RESUME_LLM_API_KEY=
RESUME_LLM_MODEL=
RESUME_LLM_BASE_URL=

# --- Email provider ---
# dev    -> written to backend/var/outbox/ (logged only on read-only hosts)
# smtp   -> Gmail app password or Brevo free SMTP; no domain needed
# resend -> needs a verified domain to email anyone but yourself
EMAIL_PROVIDER=dev
EMAIL_API_KEY=
EMAIL_FROM=notifications@shigotai.app
SMTP_HOST=                          # smtp.gmail.com | smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- File storage (resume uploads) ---
# "dev" writes to backend/var/uploads/ on local disk -- fine for local dev,
# but serverless/PaaS hosts have an ephemeral or read-only filesystem.
# "none" parses the resume in memory and keeps only the fields the user
# approves (recommended for Vercel). "s3" works with AWS S3 or any
# S3-compatible store (Cloudflare R2, Backblaze B2) via STORAGE_ENDPOINT_URL.
STORAGE_PROVIDER=dev                # dev | none | s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=               # leave blank for AWS S3; set for R2/B2/MinIO
STORAGE_PUBLIC_BASE_URL=            # optional CDN/public URL prefix

# --- Web Push ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@shigotai.app

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
