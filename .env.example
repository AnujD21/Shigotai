# ---------------------------------------------------------------------------
# SHIGOTAI environment configuration
# Copy this file to .env and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Core ---
ENVIRONMENT=development            # development | production
DEMO_MODE=true                     # true = seed and serve clearly-labeled demo jobs
AUTH_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Local dev default (zero-config): sqlite:///./shigotai.db
# Production: postgresql+psycopg://user:password@host:5432/shigotai
DATABASE_URL=sqlite:///./shigotai.db

# --- Background queue ---
# Local dev default: none (in-process async worker is used automatically)
# Production: redis://localhost:6379/0 (enables Celery-based workers)
REDIS_URL=

# --- AI / LLM provider ---
# When unset, Shigotai uses the built-in rule-based DevLLMProvider so the
# app is fully functional with no external API key.
LLM_PROVIDER=dev                   # dev | anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Email provider ---
# When unset, emails are written to backend/var/outbox/ instead of being sent.
EMAIL_PROVIDER=dev                 # dev | resend | sendgrid
EMAIL_API_KEY=
EMAIL_FROM=notifications@shigotai.app

# --- Web Push ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:support@shigotai.app

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
